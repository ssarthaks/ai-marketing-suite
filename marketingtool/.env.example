## Production
NEXTAUTH_URL=
AIAGENT_APP_URL=
NEXT_PUBLIC_APP_URL=

## Development
# NEXTAUTH_URL=http://localhost:3001
# AIAGENT_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3001
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL=active.developer@example.com
#
# DEV_AUTH_* variables are server-only. The bypass works only with `next dev`
# on an exact loopback hostname and still requires an active shared identity.
# Keep the dev server loopback-bound; the provided npm dev scripts do this.

EXTERNAL_API_SECRET=
SSO_SECRET=
AUTH_SECRET=

AUTH_TRUST_HOST=
ALLOW_CUSTOM_AI_ENDPOINTS=

